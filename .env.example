HOST_PORT=8155
PUBLIC_DOMAIN=http://localhost
POSTGRES_DB=botanica
POSTGRES_USER=botanica
POSTGRES_PASSWORD=change-me-before-exposing
NODE_ENV=development
# Optional comma-separated exact browser origins for authenticated POST requests.
# PUBLIC_DOMAIN remains an origin without a port. Add Vite's origin for npm run dev.
# PUBLIC_ORIGINS=http://localhost:8155,http://localhost:5173,http://127.0.0.1:8155,http://192.168.1.197:8155,https://botanica.p20.dev
