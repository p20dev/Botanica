    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "pg": "^8.16.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "tsx": "^4.20.0"
  }
