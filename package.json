{
  "name": "botanica",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w @botanica/server\" \"npm run dev -w @botanica/web\"",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "db:migrate": "npm run db:migrate -w @botanica/server",
    "db:seed": "npm run db:seed -w @botanica/server"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "vitest": "^4.1.0",
    "concurrently": "^9.2.1",
    "@types/node": "^24.0.0"
  }
}
